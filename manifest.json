{
  "manifest_version": 3,
  "name": "Job Tracker Auto Logger",
  "version": "1.0",
  "description": "Automatically logs your job applications.",
  
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.unstop.com/*",
    "*://*.internshala.com/*",
    "http://localhost:4000/*",
    "https://job-application-tracker-five-nu.vercel.app/*",
    "https://webhook.site/*"
  ],

  "externally_connectable": {
    "matches": [
      "*://*.linkedin.com/*",
      "*://*.unstop.com/*",
      "*://*.internshala.com/*",
      "http://localhost:4000/*",
      "https://job-application-tracker-five-nu.vercel.app/*"
    ]
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.unstop.com/*",
        "*://*.internshala.com/*"
      ],
      "js": ["content.js"]
    },
    {
      "matches": ["http://localhost:3000/*", "https://job-application-tracker-five-nu.vercel.app/*"],
      "js": ["saveToken.js"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon.png"
  }
}
